[Unit]
Description=Jarvis Ultimate (local persistent mode, no Upstash)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis/app
EnvironmentFile=/etc/jarvis/jarvis.env
ExecStart=/opt/jarvis/venv/bin/python /opt/jarvis/app/scripts/start_without_upstash.py
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/jarvis
ProtectHome=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
