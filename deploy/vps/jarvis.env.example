# Copy to /etc/jarvis/jarvis.env with chmod 600; NEVER commit real secrets.
DATA_DIR=/var/lib/jarvis
JARVIS_PERSISTENT_STORAGE_CONFIRMED=YES
JARVIS_ALLOW_EMPTY_STORE=YES
PORT=8000
# Set Jarvis owner and Telegram credentials privately AFTER preflight.
# Do NOT set UPSTASH_REDIS_REST_URL or UPSTASH_REDIS_REST_TOKEN.
# Do not enable payments or real trading by default.
CRYPTO_PRACTICE_ONLY=true
COINBASE_TRADING_ENABLED=false
