+      setAttribute(){}, focus(){}, addEventListener(){}, children:[], appendChild(el){this.children.push(el)} };
+  }
+  const win = { crypto: require('node:crypto').webcrypto, JarvisWav:require('../desktop/ui/wav.js'),
