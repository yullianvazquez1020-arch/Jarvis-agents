# Copy values into Render Environment. Keep existing real secrets; placeholders are not credentials.
AGENT_API_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_ID=
TELEGRAM_OWNER_USER_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
OWNER_NAME=Yullian
BUSINESS_NAME=ISLAFIX PRO LLC
TZ_NAME=America/Puerto_Rico
# Crypto mode (v4.0.3). Practice is the default. These two values keep REAL mode unavailable.
# Real mode needs ALL of: CRYPTO_PRACTICE_ONLY=false, COINBASE_TRADING_ENABLED=true,
# COINBASE_API_KEY_NAME and COINBASE_API_PRIVATE_KEY — and even then the owner must select it with
# /cripto modo real + /confirmar modo CODE. See CONFIGURACION_4_0_3.md.
CRYPTO_PRACTICE_ONLY=true
COINBASE_TRADING_ENABLED=false
MONEY_MAX_ORDER_USD=100
MONEY_MAX_DAY_USD=300
PAPER_TRADING_ENABLED=true
PAPER_START_USD=1000
PAPER_PRODUCTS=BTC-USD,ETH-USD,SOL-USD
PAPER_EVERY_HOURS=1
PAPER_REPORT_HOUR=20
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
DAILY_BRIEF_HOUR=8
MARKET_ANALYSIS_ENABLED=false
# The optional integration variables are listed in CONFIGURACION_4_0_2.md.
# No OpenAI/local router or voice Mini App is included in this release.
# Desktop voice/monitor API (v4.0.4). Keep false until the Mac companion is set up; see docs/VOICE_DESKTOP.md.
DESKTOP_API_ENABLED=false
# 4.0.5: messages per minute per key (/chat) or per chat (Telegram); 1-120.
RATE_LIMIT_PER_MIN=30
