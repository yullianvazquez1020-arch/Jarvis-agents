# Plantilla Jarvis. Valores vacíos a propósito. No se la pases llena a Claude.
# Obligatoria para arrancar
AGENT_API_KEY=
# Encargos por API (POST /api/encargo, header X-Jarvis-Secret). Vacío = endpoint cerrado.
JARVIS_ENCARGO_SECRET=
# Bus de negocios: claves distintas de JARVIS_ENCARGO_SECRET. Lectura y escritura no se comparten.
JARVIS_BUS_READ_SECRET=
JARVIS_BUS_WRITE_SECRET=
OWNER_NAME=
TZ_NAME=America/Puerto_Rico
DATA_DIR=.

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_ID=
TELEGRAM_OWNER_USER_ID=

# Upstash. Las dos o ninguna
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# IA. Sin Anthropic los comandos viven y el chat no
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
OPENAI_API_KEY=

# Twilio. WhatsApp de prueba: whatsapp:+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
# 4.2.1: /brief solo corre si BUSINESS_NAME coincide con el negocio registrado (ISLAFIX PRO LLC). Si no, se detiene.
BUSINESS_NAME=

# Cripto. Déjalas apagadas
CRYPTO_PRACTICE_ONLY=true
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=
COINBASE_TRADING_ENABLED=false
COINBASE_AGENT_URL=
MONEY_MAX_ORDER_USD=
MONEY_MAX_DAY_USD=
COINBASE_MAX_ORDER_USD=
COINBASE_MAX_DAY_USD=

# Práctica
PAPER_TRADING_ENABLED=
PAPER_PRODUCTS=
PAPER_START_USD=
PAPER_EVERY_HOURS=
PAPER_REPORT_HOUR=
PAPER_TRADE_ALERTS=

# Agentes externos
EXTERNAL_AGENT_KEY=
EXTERNAL_AGENT_HOSTS=
INCOMING_AGENT_API_KEY=
CALL_AGENT_URL=
SMS_AGENT_URL=
EMAIL_AGENT_URL=
CALENDAR_AGENT_URL=
AMAZON_AGENT_URL=
STT_AGENT_URL=
STT_AGENT_API_KEY=
TTS_AGENT_URL=
TTS_AGENT_API_KEY=

# Amazon y YouTube
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Escritorio
DESKTOP_API_ENABLED=false

# Programador
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
DAILY_BRIEF_HOUR=7
BILL_NOTICE_DAYS=2
RATE_LIMIT_PER_MIN=

# Banco y avisos
BANK_DEFAULT_NAME=
BANK_STALE_DAYS=
BANK_WEEKLY_ENABLED=
BANK_WEEKLY_DAY=
BANK_WEEKLY_HOUR=
CLIENT_NOTICES_ENABLED=true
CLIENT_NOTICE_HOUR=9
OUTBOX_MAX_PER_DAY=20

# Mercado
MARKET_ANALYSIS_ENABLED=false
MARKET_ANALYSIS_HOURS=6
WEB_SEARCH_ENABLED=true

# Calendario
CAL_ALLDAY_HOUR=

# Nuevas de 4.2.0. Estas sí faltaban en el zip
# DATA_ENCRYPTION_KEY: 32 bytes en base64, distinta de AGENT_API_KEY. Sella historial y perfil (AES-256-GCM).
#   Generar: python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
#   Vacía = historial y perfil en claro. Mal puesta = no se guardan. Si la pierdes, lo sellado no abre.
#   La pone el dueño en Render; nunca por chat. Antes: guardarla en dos sitios y anotar su huella.
#   Después: /cifrado revisar y /cifrado migrar. Procedimiento completo: docs/CIFRADO_HISTORIAL.md
DATA_ENCRYPTION_KEY=
# PUBLIC_HOST: opcional. Vacía = no se filtra por host. Si la pones, EXACTAMENTE el host del servicio
#   (ej. jarvis-agents.onrender.com): con otro valor Telegram y /chat reciben 400. /health nunca se filtra.
PUBLIC_HOST=

# Voz local por Telegram (jarvis_chat_voice). Solo se usa si STT_AGENT_URL está vacía.
# faster-whisper ya está en requirements. Apagada hasta probar una nota corta en Render (512 MB es justo).
LOCAL_VOICE_ENABLED=false
# Preguntas/saludos por voz sin /dictado, exclusivamente con herramientas de solo lectura.
# Acciones y dictados no reconocidos como preguntas conservan aprobación explícita.
LOCAL_VOICE_AUTO_REPLY=false
# Candidatos de búsqueda de Whisper (1-5). 1 por defecto; súbelo solo después de medir tiempo y memoria en Render.
WHISPER_BEAM=1
WHISPER_MODEL_DIR=

# Recepción de consultas públicas: apagada hasta alojar y probar la ficha en el mismo dominio.
BUSINESS_REQUESTS_ENABLED=false

# 4.2.0 — short model only when local rules do not cover the message. Does not raise money caps.
JARVIS_SHORT_MODEL=claude-haiku-4-5
# Own Twilio number for drafts (sms/whatsapp/call). Sends still require /enviar. No auto-send.
# TWILIO_OWN_NUMBER=+1...

# Enrutador de modelos (jarvis_router.py). Apagado hasta que el dueño lo autorice. Solo texto: no ejecuta acciones.
# Datos de clientes, facturas, teléfonos, correos, direcciones o credenciales -> solo Ollama local; si no responde, error.
JARVIS_ROUTER_ENABLED=0
JARVIS_LOCAL_MODEL=qwen3:4b-instruct
# Ollama debe estar en esta máquina (127.0.0.1, localhost o ::1). En Render no existe: lo sensible dará error.
OLLAMA_URL=
JARVIS_API_ORDER=deepseek,qwen,kimi
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_MODEL=
QWEN_MODEL=
# Confirmar el nombre exacto con Moonshot antes de activar
KIMI_MODEL=
JARVIS_LOCAL_TIMEOUT=
JARVIS_API_TIMEOUT=

# Venice externo: requiere habilitación explícita; nunca activar solo por tener clave.
VENICE_ENABLED=0
VENICE_API_KEY=
VENICE_MODEL=venice-uncensored
# 4.2.7 BRAIN: ciclo autónomo (apagado salvo BRAIN_ENABLED=true; /brain on|off|estado en tu chat privado)
BRAIN_ENABLED=false
BRAIN_URL=https://raw.githubusercontent.com/yullianvazquez1020-arch/jarvis-ai-automation/main/BRAIN.md
BRAIN_INTERVAL_MIN=60
BRAIN_MAX_CYCLES_DAY=24
GUMROAD_URL=
AI_MAX_TOKENS=1500
# 4.2.8 Autopublicación de posts propios en FB/IG del dueño (sin /confirmarred). Apagado por defecto.
AUTO_PUBLISH_OWN_SOCIAL=false
AUTO_PUBLISH_MAX_DAY=6
# YouTube autopublicación: usa YOUTUBE_CLIENT_SECRET/YOUTUBE_REFRESH_TOKEN de arriba y además:
YOUTUBE_CLIENT_ID=
YOUTUBE_CHANNEL_ID=
# TikTok Content Posting API. Sin auditoría de TikTok solo publica en privado (SELF_ONLY).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_PRIVACY=SELF_ONLY
