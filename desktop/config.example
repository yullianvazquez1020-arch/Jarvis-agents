# Jarvis desktop companion — configuration for THE MAC (never put these in Render).
# Copy to ~/.jarvis-desktop/config.env and edit. Environment variables override this file.
# No secrets go here: the device token is saved by the pairing flow in ~/.jarvis-desktop/device.json (0600).

# Your Jarvis on Render (HTTPS). Leave empty and set VOICE_DEMO=true to try the panel with example data.
JARVIS_SERVER_URL=https://jarvis-agents.onrender.com
VOICE_DEMO=false

# Only this machine can open the panel.
VOICE_BIND_HOST=127.0.0.1
VOICE_PORT=8765

# Speech-to-text. "none" = type your questions. "whisper_cpp" only AFTER measuring it on this Mac.
VOICE_STT_BACKEND=none
# VOICE_WHISPER_BIN=/Users/YOU/whisper.cpp/build/bin/whisper-cli
# VOICE_STT_MODEL_PATH=/Users/YOU/whisper.cpp/models/ggml-base.bin   (multilingual; never a .en model)
# VOICE_STT_THREADS=4

# Text-to-speech. "auto" usa Piper si hay una voz .onnx, y si no la voz de macOS.
VOICE_TTS_BACKEND=auto
# VOICE_TTS_VOICE=auto-latino         (macos_say: Juan es_MX para español y Daniel en_GB para inglés; nunca voces femeninas. JARVIS_VOZ_ES, JARVIS_VOZ_EN, JARVIS_VOZ_RATE=170)
# VOICE_PIPER_BIN=/usr/local/bin/piper

# Phase 2 (not implemented yet): keep false.
VOICE_WAKE_WORD_ENABLED=false
# Keep recordings? false = every temporary audio file is deleted right after transcription.
VOICE_RETAIN_AUDIO=false

# Faster greedy decoding using the same local model; compare accuracy on your voice.
# Enabled by default. Set false to restore the previous decoder settings.
# VOICE_STT_FAST=true
