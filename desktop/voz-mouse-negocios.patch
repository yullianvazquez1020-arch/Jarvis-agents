+        voice = engines.MacSay(cfg.get("VOICE_TTS_VOICE", "auto-latino")).resolve_voice()
+        subprocess.Popen(["say", "-v", voice, line], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+    except Exception:
+        return
